---
---
  <section class="hero" aria-labelledby="h-hero">
    <div class="wrap">
      <div class="hud-row top hud">
        <span>PHX-01 <span class="on">//</span> Rebirth sequence</span>
        <span>25.7617° N · 80.1918° W <span class="hot">·</span> Miami</span>
      </div>

      <div class="hero-copy">
        <p class="prepared" id="prepared" hidden></p>
        <p class="eyebrow">AI systems for freight forwarders, customs brokers &amp; 3PLs</p>
        <h1 id="h-hero">Resurrect the way your <span class="fire">business runs.</span></h1>
        <p class="lede">Phoenix World builds custom AI systems that read your shipping documents, enter the data, answer the routine emails, and hand your team only the work that needs a person.</p>
        <div class="cta-row">
          <a class="btn btn-fire" href="#audit">Book a 20-minute workflow audit
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8 H13 M9 4 L13 8 L9 12" stroke="currentColor" stroke-width="2"/></svg></a>
          <a class="btn btn-ghost" href="#rebirth">See the systems</a>
        </div>
        <form class="igniter" id="igniter" aria-label="See your company reborn">
          <div class="field"><label for="f-co">See your company reborn</label><input id="f-co" type="text" maxlength="32" placeholder="Your company name" autocomplete="organization"></div>
          <button class="btn btn-ghost" type="submit">Ignite</button>
        </form>
      </div>

      <div class="seq hud">
        <div class="seq-meter"><span>Sequence</span><div class="seq-bar"><i id="seqFill"></i></div><span class="on" id="seqPct">000%</span></div>
        <span id="seqState">Ashes → Phoenix</span>
        <span class="scroll-cue"><svg width="12" height="16" viewBox="0 0 12 16" fill="none" aria-hidden="true"><path d="M6 1 V13 M1 9 L6 14 L11 9" stroke="#5CE1FF" stroke-width="1.5"/></svg>Scroll to transform</span>
      </div>
    </div>
  </section>
