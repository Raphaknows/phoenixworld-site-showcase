{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phoenixworld-site",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2025-01-01",
  "env": {
    "production": {
      "vars": {
        "GATE_DISABLED": "true",
        "NOINDEX": "false",
        "PUBLIC_FORMSPREE_ID": "mjyyeogb",
        "NODE_VERSION": "22",
        "PUBLIC_PHOENIX_VOICE": "false"
      }
    },
    "preview": {
      "vars": {
        "GATE_DISABLED": "true",
        "NOINDEX": "true",
        "PUBLIC_FORMSPREE_ID": "mjyyeogb",
        "NODE_VERSION": "22",
        "PUBLIC_PHOENIX_VOICE": "true"
      }
    }
  }
}
